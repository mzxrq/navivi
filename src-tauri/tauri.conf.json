{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Navivi",
  "version": "1.0.0",
  "identifier": "navivi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Navivi",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false
      },
      {
        "label": "splash",
        "title": "Navivi",
        "url": "splash.html",
        "width": 420,
        "height": 460,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": [
            "**/.ssh/**", "**/.aws/**", "**/.azure/**", "**/.gnupg/**", "**/.kube/**", "**/.docker/**",
            "**/.git-credentials", "**/.npmrc", "**/.netrc", "**/.env", "**/.env.*",
            "**/id_rsa*", "**/id_ed25519*", "**/*.pem", "**/*.pfx", "**/*.kdbx",
            "$APPDATA/Microsoft/Credentials/**", "$APPDATA/Microsoft/Protect/**", "$LOCALAPPDATA/Microsoft/Credentials/**",
            "$LOCALAPPDATA/Google/**", "$LOCALAPPDATA/Microsoft/Edge/**", "$LOCALAPPDATA/BraveSoftware/**", "$LOCALAPPDATA/Vivaldi/**",
            "$APPDATA/Mozilla/**", "$APPDATA/Opera Software/**",
            "$APPDATA/navivi/**", "$LOCALAPPDATA/navivi/EBWebView/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
