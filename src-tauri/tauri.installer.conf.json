{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/stage-installer.mjs"
  },
  "bundle": {
    "targets": ["nsis"],
    "shortDescription": "Turn routes into narrated travel videos",
    "resources": {
      "installer-staging/src-python": "src-python",
      "installer-staging/tools": "tools"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    }
  }
}
