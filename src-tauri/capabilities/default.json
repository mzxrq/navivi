{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:menu:default",
    "fs:default",
    "dialog:default",
    "fs:allow-exists",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "http:allow-fetch",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/**" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**/*" }],
      "deny": [
        { "path": "**/.ssh/**" }, { "path": "**/.aws/**" }, { "path": "**/.azure/**" }, { "path": "**/.gnupg/**" },
        { "path": "**/.kube/**" }, { "path": "**/.docker/**" },
        { "path": "**/.git-credentials" }, { "path": "**/.npmrc" }, { "path": "**/.netrc" }, { "path": "**/.env" }, { "path": "**/.env.*" },
        { "path": "**/id_rsa*" }, { "path": "**/id_ed25519*" }, { "path": "**/*.pem" }, { "path": "**/*.pfx" }, { "path": "**/*.kdbx" },
        { "path": "$DATA/Microsoft/Credentials/**" }, { "path": "$DATA/Microsoft/Protect/**" }, { "path": "$LOCALDATA/Microsoft/Credentials/**" },
        { "path": "$LOCALDATA/Google/**" }, { "path": "$LOCALDATA/Microsoft/Edge/**" }, { "path": "$LOCALDATA/BraveSoftware/**" }, { "path": "$LOCALDATA/Vivaldi/**" },
        { "path": "$DATA/Mozilla/**" }, { "path": "$DATA/Opera Software/**" },
        { "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/EBWebView/**" }
      ]
    }
  ]
}
